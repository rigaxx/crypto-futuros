# ==========================================
# CREDENCIAIS BINANCE FUTURES USDⓈ-M
# ==========================================
# Gere suas chaves em: https://www.binance.com/pt/my/settings/api-management
# Habilite a permissão: "Ativar Futuros" (Enable Futures)
BINANCE_API_KEY=sua_binance_api_key_aqui
BINANCE_SECRET=sua_binance_secret_aqui

# Endpoints da Binance Futures
# Para Produção (Real):
FUTURES_BASE=https://fapi.binance.com
FUTURES_WS=wss://fstream.binance.com

# Para Testnet (Testes sem dinheiro real):
# FUTURES_BASE=https://testnet.binancefuture.com
# FUTURES_WS=wss://stream.binancefuture.com

# ==========================================
# INTELIGÊNCIA ARTIFICIAL (9ROUTER / OPENAI COMPATIBLE)
# ==========================================
# Token de autorização para o endpoint de IA (padrão 9Router ou OpenAI API)
ROUTER_API_KEY=seu_token_aqui

# ==========================================
# CONFIGURAÇÕES DO PAINEL WEB
# ==========================================
PORT=7005
ACESSO_SENHA=admin123
